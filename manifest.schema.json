{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kindel app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes", "apps"],
  "properties": {
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "status", "themes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["live", "beta", "later"]
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*/$"
        },
        "routes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
